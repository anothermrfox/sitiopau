---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/images/pc.png';
import { Content as Hero } from '../../contenido/inicio/hero.md';
import { Content as Enfoque } from '../../contenido/inicio/enfoque.md';
import { Content as Servicios } from '../../contenido/inicio/servicios.md';
import { Content as Trayectoria } from '../../contenido/inicio/trayectoria.md';
import { Content as Alochic } from '../../contenido/inicio/alochic.md';
import { Content as Contacto } from '../../contenido/inicio/contacto.md';
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Comunicación · Marketing · Negocios</p>
      <div class="hero-content"><Hero /></div>
      <div class="hero-actions">
        <a class="button" href="/contacto/">Conversemos</a>
        <a class="text-link" href="/servicios/">Ver cómo puedo ayudarte <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Retrato profesional de Paula Carvajal"
          widths={[420, 640, 900]}
          sizes="(max-width: 960px) 78vw, 38vw"
          format="webp"
          quality={86}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="visual-word word-strategy">Estrategia</span>
      <span class="visual-word word-content">Contenido</span>
      <span class="visual-word word-cx">CX</span>
      <span class="visual-word word-sales">Negocios</span>
      <figcaption>Paula Carvajal</figcaption>
    </figure>
  </section>

  <section class="trust-strip" aria-label="Resumen profesional">
    <p><strong>+10 años</strong><span>de experiencia</span></p>
    <p><strong>4 áreas</strong><span>conectadas por una visión</span></p>
    <p><strong>Chile</strong><span>trabajo presencial y remoto</span></p>
  </section>

  <section class="home-section intro-section">
    <div class="section-number" aria-hidden="true">01</div>
    <div class="section-content prose lead-prose"><Enfoque /></div>
  </section>

  <section class="home-section services-section">
    <div class="section-number" aria-hidden="true">02</div>
    <div class="section-content">
      <div class="prose section-heading"><Servicios /></div>
      <a class="text-link" href="/servicios/">Explorar servicios <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section experience-section">
    <div class="section-number" aria-hidden="true">03</div>
    <div class="section-content prose experience-content"><Trayectoria /></div>
  </section>

  <section class="feature-panel">
    <div class="feature-label">Proyecto destacado</div>
    <div class="prose feature-content"><Alochic /></div>
    <a class="text-link light-link" href="/alochic/">Conocer el proyecto <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-banner">
    <div class="prose"><Contacto /></div>
    <a class="button button-dark" href="mailto:pcarvajal.riquelme@gmail.com">Escribir a Paula</a>
  </section>
</BaseLayout>
